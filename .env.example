# Copy to .env for local development. Values here are local-development placeholders only.

# --- API server ---
PORT=3100
DATABASE_URL=postgres://ecr:ecr_dev_only@localhost:5443/ecr
TEST_DATABASE_URL=postgres://ecr:ecr_dev_only@localhost:5443/ecr_test

# Public origin users open in the browser (the web app; /api is proxied to the API).
PUBLIC_BASE_URL=http://localhost:5173

# --- DWS Hub (strict OIDC) ---
HUB_ISSUER=http://localhost:4000
# Optional; defaults to ${HUB_ISSUER}/api/sso/.well-known/openid-configuration
# HUB_DISCOVERY_URL=
OIDC_CLIENT_ID=ecr-local
HUB_DASHBOARD_URL=http://localhost:4000/dashboard

# Roles given to an ECR account created on a user's first DWS Hub sign-in (comma-separated, may be empty).
# DWS Hub decides who may use ECR; privileged roles are granted afterwards by a User Admin.
JIT_DEFAULT_ROLES=VIEWER
# Privileged roles that never need the ECR authenticator (comma-separated). Default SUPER_ADMIN; empty = every
# privileged role must enrol and confirm codes before sensitive actions.
TOTP_EXEMPT_ROLES=SUPER_ADMIN
# Name shown in authenticator apps for ECR step-up codes.
TOTP_ISSUER=ECR

# --- Security ---
# true behind HTTPS (UAT/production): cookies become __Host-/__Secure- prefixed and Secure.
COOKIE_SECURE=false
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In UAT/production this comes from Alibaba Cloud KMS, never from a file.
ECR_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
# Office and VPN ranges (comma-separated CIDR). Local development allows loopback only.
ALLOWED_NETWORKS=127.0.0.0/8,::1/128
# Number of trusted proxy hops in front of the API (Alibaba SLB = 1).
TRUST_PROXY=0

# --- Source documents ---
# Local folder standing in for the private OSS bucket (relative to backend/). UAT/production use OSS.
STORAGE_DIR=var/storage
# ClamAV daemon that scans every uploaded PDF. Required (and enforced at startup) when MALWARE_SCAN_REQUIRED=true,
# which is the default whenever COOKIE_SECURE=true. Locally, uploads are stored as NOT_SCANNED without it.
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# MALWARE_SCAN_REQUIRED=false

# --- Publishing ---
# How often scheduled change sets are checked for publication (ms). 0 disables the in-process job.
PUBLISH_DUE_INTERVAL_MS=60000

# --- Notifications ---
# Emails are written to an outbox with each workflow change and sent by an in-process job every EMAIL_OUTBOX_INTERVAL_MS
# (0 disables it). MAIL_TRANSPORT: smtp (UAT/production, required when COOKIE_SECURE=true), log (local development:
# messages go to the API log) or memory (tests). Defaults to smtp when SMTP_HOST is set, otherwise log.
# MAIL_TRANSPORT=log
# SMTP_HOST=smtp.corp.example
# SMTP_PORT=587
# SMTP_SECURE=false          # true = TLS from the start (port 465); false = STARTTLS
# SMTP_REQUIRE_TLS=true      # set false only for a relay on the same host or network segment
# SMTP_USER=
# SMTP_PASSWORD=             # UAT/production: from Alibaba Cloud KMS
MAIL_FROM=ECR <no-reply@ecr.local>
EMAIL_OUTBOX_INTERVAL_MS=60000

# --- Large exports ---
# Catalogue exports above this many rows are prepared in the background and the requester is notified (US-47-N1 AC3);
# 0 sends every catalogue export to the background.
EXPORT_ASYNC_THRESHOLD=50000
# How often the export runner looks for queued exports and removes files older than 24 h (ms); 0 disables it.
EXPORT_JOB_INTERVAL_MS=15000

# --- Scheduled jobs ---
# How often the scheduler checks which jobs are due (dq-nightly, dormancy, audit-chain-verify, ref-gap-check,
# jwks-refresh, session-sweep, access-review); 0 disables it.
SCHEDULER_TICK_MS=60000

# --- Configuration screen ---
# Timeouts, roles at first sign-in, ALLOWED_NETWORKS and the disclaimer can be changed by a Super Admin on
# /admin/config; a saved value overrides the one above. Each API instance reloads saved values this often (ms).
SETTINGS_REFRESH_MS=5000
