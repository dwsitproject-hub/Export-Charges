# Production frontend settings (FE server 172.28.80.50). Copy to frontend/.env.prod on the server; never commit it.

# --- Where the web app listens on the FE server ---
# 3160 was free on 172.28.80.50 (docs/DEPLOY-PROD.md §1).
ECR_WEB_BIND=0.0.0.0
ECR_WEB_PORT=3160
# The API on the BE server (backend/.env.prod: ECR_API_BIND:ECR_API_PORT).
ECR_API_UPSTREAM=http://172.28.80.51:4160

# --- DWS Hub SDK (build time; leave both empty to build without it) ---
# Script of the PRODUCTION Hub, and the key from production Hub Admin → Applications → Export Charges Registry → SDK.
VITE_HUB_SDK_URL=CHANGE_ME/api/sdk/v1/hub-sdk.js
VITE_HUB_SDK_KEY=CHANGE_ME
# VITE_GIT_SHA is set by the deploy script from the commit being built.
