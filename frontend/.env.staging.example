# Staging frontend settings (FE server 172.28.92.56). Copy to frontend/.env.staging on the server; never commit it.

# --- Where the web app listens on the FE server ---
ECR_WEB_BIND=0.0.0.0
ECR_WEB_PORT=3160
# The API on the BE server (backend/.env.staging: ECR_API_BIND:ECR_API_PORT).
ECR_API_UPSTREAM=http://172.28.92.57:4160

# --- DWS Hub SDK (build time; leave empty to build without it) ---
# Script of the staging Hub, and the key from staging Hub Admin → Applications → Export Charges Registry → SDK.
VITE_HUB_SDK_URL=CHANGE_ME/api/sdk/v1/hub-sdk.js
VITE_HUB_SDK_KEY=CHANGE_ME
# VITE_GIT_SHA is set by the deploy script from the commit being built.
